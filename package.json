    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.7",
    "fast-check": "^4.11.0",
    "istanbul-badges-readme": "^1.9.0",
    "jest": "^30.5.2",
